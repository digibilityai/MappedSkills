# =============================================================================
# MappedSkills — ENVIRONMENT CONTRACT
#
# Every variable below is one the application ACTUALLY READS (verified against
# the source by grep during the 2026-09-18 repository reconciliation). This file
# carries NO VALUES. Never put a real value here: this repository is public.
#
# Copy to `.env.local` for local development. `.env`, `.env.local` and every
# other `.env.*` file are gitignored; only this template is tracked.
#
# TWO KINDS OF VARIABLE — the difference decides WHERE a value must be supplied:
#
#   BUILD-TIME / PUBLIC  (`NEXT_PUBLIC_*`)
#     Inlined into the client JavaScript by `next build`. Setting one on the
#     production host AFTER the build has NO EFFECT. They must be present in the
#     environment of the machine that runs `npm run build` (for production, the
#     GitHub Actions `verify` job). They are visible to every visitor, so they
#     must never hold a secret.
#
#   RUNTIME / PRIVATE
#     Read on the server only. Supplied to the running Node process on the
#     production host (cPanel "Setup Node.js App" environment). Never prefixed
#     with NEXT_PUBLIC_, never sent to a browser.
#
# Removed during reconciliation because NOTHING reads them:
#   NEXT_PUBLIC_BUSINESS_NAME, NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION,
#   CONTACT_NOTIFICATION_EMAIL.
# =============================================================================


# --- BUILD-TIME / PUBLIC -----------------------------------------------------

# Canonical origin, no trailing slash (e.g. https://example.com). Used for
# canonical URLs, Open Graph, JSON-LD, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container ID (GTM-XXXXXXX). REQUIRED FOR PRODUCTION.
# The ONLY analytics integration: GA4 is configured inside the container, not
# in application code. Loads only after the visitor grants analytics consent.
# A production build without it ships with analytics permanently disabled;
# `npm run verify:build:production` fails in that case.
NEXT_PUBLIC_GTM_ID=

# GA4 measurement ID. Read into site metadata only; GA4 itself is loaded by
# the GTM container, never directly by this application.
NEXT_PUBLIC_GA4_ID=

# Meta Pixel ID. MUST STAY EMPTY until the owner decides whether Meta Pixel is
# retained (EVENT_TAXONOMY.md §9 decision 4). If set, it loads only after the
# visitor grants analytics consent.
NEXT_PUBLIC_META_PIXEL_ID=

# External booking page URL used by the schedule-call surface.
NEXT_PUBLIC_CALENDLY_URL=

# Public business contact details (fallbacks exist in lib/metadata.ts).
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Social profile URLs (optional).
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=


# --- BUILD-TIME AND RUNTIME / PRIVATE ------------------------------------------

# Contentful Delivery API. Needed at BUILD time (static generation of blog and
# portfolio routes) AND at RUNTIME (60-second incremental revalidation). Both
# places must hold the same, current token. When unset, the blog and portfolio
# render their empty states instead of failing.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
# Contentful environment name; the application defaults when unset.
CONTENTFUL_ENVIRONMENT=


# --- RUNTIME / PRIVATE -----------------------------------------------------------

# Enquiry persistence (MariaDB / MySQL). REQUIRED at runtime. Without them the
# enquiry API answers 503 and the visitor is told the enquiry did not go
# through; it never reports a false success.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=


# --- PROCESS / TOOLING (normally left unset) -------------------------------------

# Port and bind address for server.cjs (defaults: 3000, 0.0.0.0). The host's
# Passenger integration normally supplies PORT.
PORT=
HOSTNAME=

# `1` renders internal pages (e.g. /launch-checklist) in a production build.
# Leave unset in production.
ENABLE_INTERNAL_PAGES=

# `1` makes `npm run build:cpanel` use a single build worker. Host builds are
# retired by the proposed release workflow; kept for the manual fallback.
CPANEL_BUILD=
