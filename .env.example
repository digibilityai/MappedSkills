# Site Configuration
NEXT_PUBLIC_SITE_URL=https://mappedskills.com
NEXT_PUBLIC_BUSINESS_NAME=MappedSkills Marketing
NEXT_PUBLIC_BUSINESS_EMAIL=info@mappedskills.com
NEXT_PUBLIC_BUSINESS_PHONE=+91 9873232662
NEXT_PUBLIC_BUSINESS_ADDRESS=Pune, Maharashtra, India

# Google Analytics and Tracking
#
# NEXT_PUBLIC_GTM_ID — the Google Tag Manager container id, and the ONLY
# analytics provider this application loads. Delivery is CONSENT-GATED: the
# container script is requested only when this variable is set AND the visitor
# has explicitly accepted analytics in the site's own consent banner. Undecided
# and declined both load nothing. Google Consent Mode v2 defaults
# (analytics_storage, ad_storage, ad_user_data, ad_personalization — all DENIED)
# are established in the document head on every page load regardless of this
# value. Leaving it empty keeps the application fully functional and silent.
#
# NO CONTAINER ID IS RECORDED IN THIS REPOSITORY. This file is tracked; the
# production value belongs only in the host's environment configuration
# (cPanel > Setup Node.js App > Environment variables).
NEXT_PUBLIC_GTM_ID=
#
# NEXT_PUBLIC_GA4_ID — DECLARED BUT WIRED NOWHERE, and deliberately so. GA4 is
# delivered THROUGH the GTM container (app -> dataLayer -> GTM -> GA4). Adding a
# second, direct gtag.js loader here would double-count every event and would
# bypass the consent gate above. Do not wire it.
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (Facebook)
#
# ⚠ MUST REMAIN EMPTY. lib/meta-pixel.tsx HAS NO CONSENT GATE. Setting this
# would load fbevents.js and fire PageView for every visitor regardless of the
# choice they made in the consent banner. Advertising consent is DENIED in this
# phase and no advertising provider is approved.
NEXT_PUBLIC_META_PIXEL_ID=

# Calendly
NEXT_PUBLIC_CALENDLY_URL=

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Social Media URLs
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=

# Enquiry database (MariaDB / MySQL-compatible) — SERVER-SIDE ONLY.
#
# Required by POST /api/enquiry and by `npm run db:migrate`. All four must be
# set on the Node process or the enquiry form returns an honest failure and
# stores nothing — it never falls back to pretending a submission succeeded.
#
# NOT prefixed NEXT_PUBLIC_, and they must never be: that prefix would inline
# the values into the client bundle and publish the database password.
#
# On cPanel these are set under Setup Node.js App > Environment variables, and
# the host is the local socket the MySQL service listens on.
#
# NO VALUES ARE RECORDED IN THIS REPOSITORY. This file is tracked; production
# credentials belong only in the host's environment configuration.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional. Defaults to 3306 when unset, so the four values above are enough.
DB_PORT=

# Contact Notifications
#
# UNRESOLVED, AND NON-BLOCKING. This address names a destination and NOTHING CAN
# SEND TO IT: no transactional email provider is chosen, no credential exists
# and no email library is installed. Enquiry persistence does not depend on it —
# `POST_SUBMISSION_AND_FOLLOWUP.md` §0 makes notification a step-4 asynchronous
# integration whose failure "never fails the visitor's submission". Choosing a
# provider is an owner decision and is recorded as such.
CONTACT_NOTIFICATION_EMAIL=info@mappedskills.com

# Contentful CMS (Delivery / GraphQL API)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Redirects Configuration
# These are configured in next.config.mjs
